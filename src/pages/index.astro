---
import Layout from '../layouts/Layout.astro';
import ContenedorApp from '../components/ContenedorApp.astro';
import BarraBusqueda from '../components/BarraBusqueda.astro';
import ListaContactos from '../components/ListaContactos.astro';
import FormularioContacto from '../components/FormularioContacto.astro';
import NotificacionToast from '../components/NotificacionToast.astro';
import ConfirmacionModal from '../components/ConfirmacionModal.astro';
---
<Layout>
    <ContenedorApp>
        <!-- Contenedor simulando pantalla completa con barras de navegación -->
        <div class="w-full aspect-[9/19] max-h-[750px] bg-black rounded-[1.75rem] overflow-hidden relative">
            
            <!-- PANTALLA MÓVIL -->
            <div id="pantalla-movil" class="w-full h-[calc(100%-56px)] bg-gradient-to-b from-gray-900 via-black to-gray-900 text-white rounded-t-[1.75rem] flex flex-col overflow-hidden relative">
                
                <!-- CÁMARA FRONTAL Y SENSORES -->
                <div class="absolute top-4 left-1/2 transform -translate-x-1/2 z-50 flex items-center space-x-3">
                    <!-- Altavoz -->
                    <div class="w-8 h-1 bg-gray-700 rounded-full"></div>
                    
                    <!-- Cámara frontal -->
                    <div class="w-3 h-3 bg-gray-800 rounded-full border border-gray-600 flex items-center justify-center shadow-inner">
                        <div class="w-2 h-2 bg-gray-900 rounded-full flex items-center justify-center">
                            <div class="w-1 h-1 bg-blue-500/30 rounded-full"></div>
                        </div>
                    </div>
                    
                    <!-- Sensor de proximidad -->
                    <div class="w-1 h-1 bg-red-900/50 rounded-full"></div>
                </div>
                
                <!-- Efecto de reflejo superior -->
                <div class="absolute top-0 left-0 right-0 h-24 bg-gradient-to-b from-white/5 to-transparent rounded-t-[1.75rem] pointer-events-none"></div>
            
            <!-- HEADER -->
            <header class="flex-shrink-0 pt-12 pb-2 bg-gradient-to-b from-gray-900 to-transparent">
                <div class="px-4">
                    <h1 class="text-3xl font-bold bg-gradient-to-r from-white to-gray-300 bg-clip-text text-transparent">Contactos</h1>
                    <div class="flex items-center mt-1">
                        <div class="w-1.5 h-1.5 bg-green-400 rounded-full mr-2 animate-pulse"></div>
                        <p id="contador-contactos" class="text-gray-400 text-xs font-medium">3 contactos</p>
                    </div>
                </div>
                
                <!-- BARRA DE BÚSQUEDA -->
                <div class="mt-3 px-4">
                    <BarraBusqueda />
                </div>
            </header>

            <!-- VISTA LISTA -->
            <main id="vista-lista" class="flex-grow overflow-y-auto mt-2 pb-14">
                <ListaContactos />
            </main>

            <!-- VISTA FORMULARIO -->
            <div id="vista-formulario" class="hidden h-full">
                <FormularioContacto />
            </div>

            <!-- BOTÓN FLOTANTE -->
            <button id="boton-agregar" class="absolute bottom-16 right-4 bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white rounded-full w-14 h-14 flex items-center justify-center shadow-lg hover:shadow-xl transition-all duration-300 hover:scale-110 z-10">
                <i class="fa-solid fa-plus text-xl"></i>
                <div class="absolute inset-0 bg-gradient-to-r from-blue-400 to-blue-500 rounded-full opacity-0 hover:opacity-20 transition-opacity duration-300"></div>
            </button>

            <!-- BARRA DE NAVEGACIÓN INFERIOR -->
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-gray-900 via-gray-800 to-gray-900 border-t border-gray-600 backdrop-blur-sm z-20">
                <div class="flex justify-around items-center px-1 py-1">
                    <!-- Favoritos -->
                    <button class="nav-item flex flex-col items-center py-2 px-3 text-gray-400 hover:text-yellow-400 transition-all duration-300 hover:scale-105 rounded-lg hover:bg-gray-700/50">
                        <div class="relative">
                            <i class="fas fa-star text-sm mb-1"></i>
                        </div>
                        <span class="text-xs font-medium">Favoritos</span>
                    </button>
                    
                    <!-- Contactos (Activo) -->
                    <button class="nav-item flex flex-col items-center py-2 px-3 text-blue-400 transition-all duration-300 scale-105 rounded-lg bg-blue-500/20 border border-blue-500/30">
                        <div class="relative">
                            <i class="fas fa-address-book text-sm mb-1"></i>
                            <div class="absolute -top-1 -right-1 w-1.5 h-1.5 bg-blue-400 rounded-full animate-pulse"></div>
                        </div>
                        <span class="text-xs font-semibold">Contactos</span>
                    </button>
                    
                    <!-- Teléfono -->
                    <button class="nav-item flex flex-col items-center py-2 px-3 text-gray-400 hover:text-green-400 transition-all duration-300 hover:scale-105 rounded-lg hover:bg-gray-700/50">
                        <div class="relative">
                            <i class="fas fa-phone text-sm mb-1"></i>
                        </div>
                        <span class="text-xs font-medium">Teléfono</span>
                    </button>
                </div>
            </div>

            <!-- COMPONENTES DE UI -->
            <NotificacionToast />
            <ConfirmacionModal />
        </div>

        <!-- BARRA DE NAVEGACIÓN SISTEMA ANDROID -->
        <div class="absolute bottom-0 left-0 right-0 bg-black/90 backdrop-blur-md rounded-b-[1.75rem]">
            <div class="flex justify-center items-center py-3 px-6">
                <!-- Botón Atrás -->
                <button class="android-nav-btn p-2 mx-6 text-white/70 hover:text-white transition-all duration-200 hover:bg-white/10 rounded-full">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 12H5M12 19l-7-7 7-7"/>
                    </svg>
                </button>
                
                <!-- Botón Inicio (Círculo) -->
                <button class="android-nav-btn p-2 mx-6 text-white/70 hover:text-white transition-all duration-200 hover:bg-white/10 rounded-full">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                    </svg>
                </button>
                
                <!-- Botón Recientes (Cuadrado) -->
                <button class="android-nav-btn p-2 mx-6 text-white/70 hover:text-white transition-all duration-200 hover:bg-white/10 rounded-full">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                    </svg>
                </button>
            </div>
        </div>
    </div>
    </ContenedorApp>
</Layout>

<script is:inline>
    // =====================================================
    // 🎯 SISTEMA DE ESTADO MODERNO - NUEVA ARQUITECTURA
    // =====================================================
    
    // 🌍 Instancia global única del estado (reemplaza todas las variables globales)
    let appState;

    // 🎨 Controlador de UI - maneja la interfaz basándose en el estado
    class UIController {
        constructor() {
            this.elements = {
                vistaLista: document.getElementById('vista-lista'),
                vistaFormulario: document.getElementById('vista-formulario'),
                botonAgregar: document.getElementById('boton-agregar'),
                headerPrincipal: document.querySelector('header'),
                contadorContactos: document.getElementById('contador-contactos')
            };
            
            this.setupObservers();
        }

        setupObservers() {
            // 🔔 Suscribirse a cambios de estado
            if (appState) {
                appState.subscribe('vista:cambiada', (data) => this.cambiarVista(data.actual));
                appState.subscribe('contactos:updated', (contactos) => this.actualizarContador(contactos));
                appState.subscribe('contactos:filtered', (contactos) => this.actualizarContador(contactos));
            }
        }

        cambiarVista(vista) {
            if (vista === 'lista') {
                this.elements.vistaLista?.classList.remove('hidden');
                this.elements.vistaFormulario?.classList.add('hidden');
                this.elements.botonAgregar?.classList.remove('hidden');
                this.elements.headerPrincipal?.classList.remove('hidden');
            } else if (vista === 'formulario') {
                this.elements.vistaLista?.classList.add('hidden');
                this.elements.vistaFormulario?.classList.remove('hidden');
                this.elements.botonAgregar?.classList.add('hidden');
                this.elements.headerPrincipal?.classList.add('hidden');
            }
        }

        actualizarContador(contactos) {
            if (this.elements.contadorContactos) {
                const cantidad = contactos.length;
                this.elements.contadorContactos.textContent = `${cantidad} contacto${cantidad !== 1 ? 's' : ''}`;
            }
        }
    }

    // 🌟 Funciones de compatibilidad (para mantener la interfaz existente de componentes)
    window.cambiarVista = function(vista) {
        if (appState) {
            appState.cambiarVista(vista);
        }
    };

    window.filtrarContactos = function(termino) {
        if (appState) {
            appState.filtrarContactos(termino);
        }
    };

    // =====================================================
    // 🚀 INICIALIZACIÓN DE LA APLICACIÓN MODERNA
    // =====================================================

    function initializeApp() {
        // 🌟 Crear instancia única del estado
        appState = new window.AppState();
        
        // 🎨 Crear controlador de UI
        const uiController = new UIController();
        
        // 🔄 Hacer appState disponible globalmente para componentes existentes
        window.appState = appState;
        
        // 📡 Configurar observadores principales
        setupMainObservers();
        
        // 🎮 Configurar event listeners de la aplicación
        setupEventListeners();
        
        // ⏱️ Inicializar componentes después de que el estado esté listo
        setTimeout(() => {
            initializeComponents();
        }, 100);
    }

    function setupMainObservers() {
        // 🔔 Observer para renderizar contactos cuando cambien
        appState.subscribe('contactos:filtered', (contactosFiltrados) => {
            if (window.renderizarContactos) {
                window.renderizarContactos();
            }
        });

        // 🔔 Observer para notificaciones
        appState.subscribe('contacto:agregado', (contacto) => {
            if (window.mostrarNotificacion) {
                window.mostrarNotificacion('✅ Contacto agregado correctamente', 'success');
            }
        });

        appState.subscribe('contacto:actualizado', (contacto) => {
            if (window.mostrarNotificacion) {
                window.mostrarNotificacion('✏️ Contacto actualizado correctamente', 'success');
            }
        });

        appState.subscribe('contacto:eliminado', (contacto) => {
            if (window.mostrarNotificacion) {
                window.mostrarNotificacion('🗑️ Contacto eliminado correctamente', 'success');
            }
        });

        // 🔔 Observer para búsqueda
        appState.subscribe('busqueda:limpiada', () => {
            const barraBusqueda = document.getElementById('barra-busqueda');
            if (barraBusqueda) {
                barraBusqueda.value = '';
            }
        });
    }

    function setupEventListeners() {
        // 🔲 Configurar botón agregar
        const botonAgregar = document.getElementById('boton-agregar');
        if (botonAgregar) {
            botonAgregar.addEventListener('click', function() {
                appState.desactivarModoEdicion();
                appState.cambiarVista('formulario');
            });
        }
        
        // 🔗 Configurar botones de la barra inferior
        const botonesNav = document.querySelectorAll('.nav-item');
        botonesNav.forEach((boton, index) => {
            boton.addEventListener('click', function() {
                if (index === 0) { // Favoritos
                    if (window.mostrarNotificacion) {
                        window.mostrarNotificacion('⭐ Función de favoritos próximamente', 'info');
                    }
                } else if (index === 1) { // Contactos (ya activo)
                    // Ya estamos en contactos, volver a lista si estamos en formulario
                    if (appState.vistaActual === 'formulario') {
                        appState.cambiarVista('lista');
                    }
                } else if (index === 2) { // Teléfono
                    if (window.mostrarNotificacion) {
                        window.mostrarNotificacion('📞 Función de teléfono próximamente', 'info');
                    }
                }
            });
        });

        // 🤖 Configurar botones de navegación Android
        const botonesAndroid = document.querySelectorAll('.android-nav-btn');
        botonesAndroid.forEach((boton, index) => {
            boton.addEventListener('click', function() {
                if (index === 0) { // Atrás
                    if (appState.vistaActual === 'formulario') {
                        appState.cambiarVista('lista');
                        if (window.mostrarNotificacion) {
                            window.mostrarNotificacion('◀️ Volviendo a la lista', 'info');
                        }
                    } else {
                        if (window.mostrarNotificacion) {
                            window.mostrarNotificacion('◀️ Botón atrás', 'info');
                        }
                    }
                } else if (index === 1) { // Inicio
                    if (window.mostrarNotificacion) {
                        window.mostrarNotificacion('🏠 Botón inicio', 'info');
                    }
                } else if (index === 2) { // Recientes
                    if (window.mostrarNotificacion) {
                        window.mostrarNotificacion('📱 Apps recientes', 'info');
                    }
                }
            });
        });
    }

    function initializeComponents() {
        // 🧩 Inicializar todos los componentes
        if (window.inicializarBarraBusqueda) window.inicializarBarraBusqueda();
        if (window.inicializarListaContactos) window.inicializarListaContactos();
        if (window.inicializarFormularioContacto) window.inicializarFormularioContacto();
        if (window.inicializarConfirmacionModal) window.inicializarConfirmacionModal();
        if (window.inicializarNotificacionToast) window.inicializarNotificacionToast();
        
        // ✨ Trigger inicial de renderizado
        if (window.renderizarContactos) {
            window.renderizarContactos();
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        // ⏱️ Esperar a que AppState esté disponible
        function waitForAppState(retries = 0) {
            if (window.AppState) {
                initializeApp();
            } else if (retries < 10) {
                setTimeout(() => waitForAppState(retries + 1), 100);
            } else {
                console.error('❌ No se pudo cargar AppState');
            }
        }
        
        waitForAppState();
    });
</script>
---
// Componente modularizado de modal de confirmación
---
<div id="modal-confirmacion" class="absolute inset-0 justify-center items-end hidden z-50 pb-8">
    <div class="bg-gray-800 rounded-2xl p-4 w-11/12 max-w-sm shadow-xl text-center">
        <p class="mb-4 text-gray-300">¿Estás seguro de que quieres eliminar este contacto?</p>
        <div class="flex justify-around">
            <button id="btn-cancelar-eliminacion" class="py-2 px-8 text-white hover:bg-gray-700 rounded-full transition-colors">Cancelar</button>
            <button id="btn-confirmar-eliminacion" class="py-2 px-8 text-red-500 hover:bg-red-900/50 rounded-full transition-colors font-semibold">Eliminar</button>
        </div>
    </div>
</div>

<script is:inline>
    // =====================================================
    // 🗑️ COMPONENTE MODAL DE CONFIRMACIÓN - SISTEMA MODERNO
    // =====================================================
    
    window.inicializarConfirmacionModal = function() {
        const modalConfirmacion = document.getElementById('modal-confirmacion');
        const btnCancelarEliminacion = document.getElementById('btn-cancelar-eliminacion');
        const btnConfirmarEliminacion = document.getElementById('btn-confirmar-eliminacion');
        
        if (!modalConfirmacion || !window.appState) return;

        // 🔔 Suscribirse a cambios de estado
        if (window.appState.subscribe) {
            // Mostrar modal cuando se prepare eliminación
            window.appState.subscribe('eliminacion:preparada', (contactoId) => {
                mostrarModal();
            });

            // Ocultar modal cuando se cancele eliminación
            window.appState.subscribe('eliminacion:cancelada', () => {
                ocultarModal();
            });

            // Ocultar modal después de eliminar
            window.appState.subscribe('contacto:eliminado', () => {
                ocultarModal();
            });
        }

        // 👁️ Función para mostrar el modal
        function mostrarModal() {
            modalConfirmacion.classList.remove('hidden');
            modalConfirmacion.classList.add('flex');
            
            // Añadir efecto de entrada
            setTimeout(() => {
                modalConfirmacion.querySelector('.bg-gray-800').classList.add('animate-pulse');
            }, 50);
        }

        // 🙈 Función para ocultar el modal
        function ocultarModal() {
            modalConfirmacion.classList.add('hidden');
            modalConfirmacion.classList.remove('flex');
            modalConfirmacion.querySelector('.bg-gray-800').classList.remove('animate-pulse');
        }

        // ❌ Event listener para cancelar eliminación
        if (btnCancelarEliminacion) {
            btnCancelarEliminacion.addEventListener('click', function() {
                window.appState.cancelarEliminacion();
            });
        }

        // ✅ Event listener para confirmar eliminación
        if (btnConfirmarEliminacion) {
            btnConfirmarEliminacion.addEventListener('click', function() {
                const contactoId = window.appState.contactoAEliminar;
                if (contactoId) {
                    window.appState.eliminarContacto(contactoId);
                    window.appState.cancelarEliminacion();
                }
            });
        }

        // 🖱️ Cerrar modal al hacer clic fuera del contenido
        modalConfirmacion.addEventListener('click', function(e) {
            if (e.target === modalConfirmacion) {
                window.appState.cancelarEliminacion();
            }
        });

        // ⌨️ Cerrar modal con tecla Escape
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && !modalConfirmacion.classList.contains('hidden')) {
                window.appState.cancelarEliminacion();
            }
        });

        // 🌟 Funciones de compatibilidad (para mantener interfaz existente)
        window.confirmarEliminacion = function(id) {
            window.appState.prepararEliminacion(id);
        };

        window.cancelarEliminacion = function() {
            window.appState.cancelarEliminacion();
        };

        window.eliminarContacto = function() {
            const contactoId = window.appState.contactoAEliminar;
            if (contactoId) {
                window.appState.eliminarContacto(contactoId);
                window.appState.cancelarEliminacion();
            }
        };
    };
</script>

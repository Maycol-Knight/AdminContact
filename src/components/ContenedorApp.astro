    <div class="absolute -start-[11px] top-48 h-16 w-1 bg-neutral-800 rounded-s-lg"></div>
    <div class="absolute -end-[11px] top-36 h-24 w-1 bg-neutral-800 rounded-e-lg"></div>

    <!-- El slot donde se renderizará toda la pantalla del móvil -->
    <slot />
</div>
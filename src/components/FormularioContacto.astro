---
// Componente modularizado de formulario de contacto
---
<div class="p-4 h-full">
    <div class="flex flex-col h-full">
        <div class="flex justify-between items-center mb-6 flex-shrink-0 pt-8">
            <h1 id="titulo-formulario" class="text-2xl font-bold">Crear Contacto</h1>
            <button id="boton-cancelar" class="text-blue-400 hover:text-blue-300">Cancelar</button>
        </div>

        <form id="formulario-contacto" class="flex-grow">
            <input type="hidden" id="id-contacto">
            <div class="mb-4">
                <label for="nombre" class="block text-sm font-medium text-gray-400">Nombre</label>
                <input type="text" id="nombre" name="nombre" class="w-full mt-1 bg-transparent border-b-2 border-gray-600 focus:border-blue-500 focus:outline-none p-2" required>
            </div>
            <div class="mb-4">
                <label for="telefono" class="block text-sm font-medium text-gray-400">Teléfono</label>
                <input type="tel" id="telefono" name="telefono" class="w-full mt-1 bg-transparent border-b-2 border-gray-600 focus:border-blue-500 focus:outline-none p-2" required>
            </div>
            <div class="mb-4">
                <label for="email" class="block text-sm font-medium text-gray-400">Correo electrónico</label>
                <input type="email" id="email" name="email" class="w-full mt-1 bg-transparent border-b-2 border-gray-600 focus:border-blue-500 focus:outline-none p-2" required>
            </div>
            <button type="submit" class="w-full mt-6 bg-blue-600 text-white font-bold py-3 rounded-lg hover:bg-blue-700 transition-colors">Guardar Contacto</button>
        </form>
    </div>
</div>

<script is:inline>
    // =====================================================
    // LÓGICA DEL COMPONENTE FORMULARIO DE CONTACTO
    // =====================================================
    
    window.inicializarFormularioContacto = function() {
        const formulario = document.getElementById('formulario-contacto');
        const tituloFormulario = document.getElementById('titulo-formulario');
        const idContactoInput = document.getElementById('id-contacto');
        const nombreInput = document.getElementById('nombre');
        const telefonoInput = document.getElementById('telefono');
        const emailInput = document.getElementById('email');
        const botonCancelar = document.getElementById('boton-cancelar');
        
        // Función para limpiar el formulario
        window.limpiarFormulario = function() {
            if (formulario) {
                formulario.reset();
                idContactoInput.value = '';
                tituloFormulario.textContent = 'Crear Contacto';
                window.appState.modoEdicion = false;
                window.appState.contactoEditando = null;
            }
        };

        // Función para cargar datos de contacto en el formulario
        window.cargarContactoEnFormulario = function(contacto) {
            if (contacto) {
                tituloFormulario.textContent = 'Editar Contacto';
                idContactoInput.value = contacto.id;
                nombreInput.value = contacto.nombre;
                telefonoInput.value = contacto.telefono;
                emailInput.value = contacto.email;
                window.appState.modoEdicion = true;
                window.appState.contactoEditando = contacto;
            }
        };

        // Función para editar contacto (llamada desde la lista)
        window.editarContacto = function(id) {
            const contacto = window.contactos.find(c => c.id === id);
            if (contacto) {
                window.cargarContactoEnFormulario(contacto);
                window.cambiarVista('formulario');
            }
        };

        // Función para agregar nuevo contacto
        window.agregarNuevoContacto = function() {
            window.limpiarFormulario();
            window.cambiarVista('formulario');
        };

        // Event listener para el formulario
        if (formulario) {
            formulario.addEventListener('submit', function(e) {
                e.preventDefault();
                
                const nombre = nombreInput.value.trim();
                const telefono = telefonoInput.value.trim();
                const email = emailInput.value.trim();

                if (nombre && telefono && email) {
                    if (window.appState.modoEdicion && window.appState.contactoEditando) {
                        // Actualizar contacto existente
                        window.appState.contactoEditando.nombre = nombre;
                        window.appState.contactoEditando.telefono = telefono;
                        window.appState.contactoEditando.email = email;
                        
                        // Guardar en localStorage
                        if (window.guardarContactosEnStorage) {
                            window.guardarContactosEnStorage();
                        }
                        
                        if (window.mostrarNotificacion) {
                            window.mostrarNotificacion('Contacto actualizado', 'success');
                        }
                    } else {
                        // Agregar nuevo contacto
                        const nuevoContacto = {
                            id: Date.now().toString(),
                            nombre,
                            telefono,
                            email
                        };
                        window.contactos.push(nuevoContacto);
                        
                        // Guardar en localStorage
                        if (window.guardarContactosEnStorage) {
                            window.guardarContactosEnStorage();
                        }
                        
                        if (window.mostrarNotificacion) {
                            window.mostrarNotificacion('Contacto agregado', 'success');
                        }
                    }
                    
                    // Actualizar lista filtrada y cambiar vista
                    window.contactosFiltrados = [...window.contactos];
                    window.cambiarVista('lista');
                    
                    // Renderizar lista actualizada
                    if (window.renderizarContactos) {
                        window.renderizarContactos();
                    }
                } else {
                    if (window.mostrarNotificacion) {
                        window.mostrarNotificacion('Por favor, complete todos los campos', 'error');
                    }
                }
            });
        }

        // Event listener para el botón cancelar
        if (botonCancelar) {
            botonCancelar.addEventListener('click', function() {
                window.cambiarVista('lista');
            });
        }
    };
</script>

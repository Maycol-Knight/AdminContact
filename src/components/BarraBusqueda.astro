---
// Componente de búsqueda modularizado
---
<div class="relative">
    <input 
        type="search" 
        id="barra-busqueda" 
        placeholder="Buscar contactos" 
        class="w-full bg-gray-800 text-white placeholder-gray-400 rounded-full py-2 pl-10 pr-4 focus:outline-none focus:ring-2 focus:ring-blue-500"
    />
    <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-500"></i>
</div>

<script is:inline>
    // =====================================================
    // 🔍 COMPONENTE BARRA DE BÚSQUEDA - SISTEMA MODERNO
    // =====================================================
    
    window.inicializarBarraBusqueda = function() {
        const barraBusqueda = document.getElementById('barra-busqueda');
        
        if (barraBusqueda && window.appState) {
            // 🔄 Configurar búsqueda en tiempo real con debounce
            let timeoutId;
            barraBusqueda.addEventListener('input', function(e) {
                const termino = e.target.value;
                
                // Debounce para optimizar rendimiento
                clearTimeout(timeoutId);
                timeoutId = setTimeout(() => {
                    window.appState.filtrarContactos(termino);
                }, 150);
            });
            
            // 🧹 Limpiar con Escape
            barraBusqueda.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    e.target.value = '';
                    window.appState.limpiarBusqueda();
                }
            });
            
            // 🔔 Escuchar cambios desde el estado
            if (window.appState.subscribe) {
                window.appState.subscribe('busqueda:limpiada', () => {
                    if (barraBusqueda.value !== '') {
                        barraBusqueda.value = '';
                    }
                });
                
                // Sincronizar con el estado actual si existe término de búsqueda
                if (window.appState.terminoBusqueda) {
                    barraBusqueda.value = window.appState.terminoBusqueda;
                }
            }
            
            // 🌟 Función pública para limpiar (mantener compatibilidad)
            window.limpiarBusqueda = function() {
                barraBusqueda.value = '';
                window.appState.limpiarBusqueda();
            };
        }
    };
</script>

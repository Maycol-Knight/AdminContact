---
// Componente de búsqueda modularizado
---
<div class="relative">
    <input 
        type="search" 
        id="barra-busqueda" 
        placeholder="Buscar contactos" 
        class="w-full bg-gray-800 text-white placeholder-gray-400 rounded-full py-2 pl-10 pr-4 focus:outline-none focus:ring-2 focus:ring-blue-500"
    />
    <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-500"></i>
</div>

<script is:inline>
    // =====================================================
    // LÓGICA DEL COMPONENTE BARRA DE BÚSQUEDA
    // =====================================================
    
    window.inicializarBarraBusqueda = function() {
        const barraBusqueda = document.getElementById('barra-busqueda');
        
        if (barraBusqueda) {
            // Búsqueda en tiempo real
            barraBusqueda.addEventListener('input', function(e) {
                const termino = e.target.value;
                if (window.filtrarContactos) {
                    window.filtrarContactos(termino);
                }
            });
            
            // Limpiar con Escape
            barraBusqueda.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    e.target.value = '';
                    if (window.filtrarContactos) {
                        window.filtrarContactos('');
                    }
                }
            });
            
            // Función específica del componente para limpiar
            window.limpiarBusqueda = function() {
                barraBusqueda.value = '';
                if (window.filtrarContactos) {
                    window.filtrarContactos('');
                }
            };
        }
    };
</script>
